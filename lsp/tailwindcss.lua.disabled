-- Tailwind CSS LSP (Native Neovim + blink.cmp)
-- Neovim 0.10+

-- 1. Get LSP capabilities from blink.cmp
local capabilities = require("blink.cmp").get_lsp_capabilities()

-- 2. Register the Tailwind LSP config (removes warnings)
vim.lsp.config("tailwindcss", {
	cmd = { "tailwindcss-language-server", "--stdio" },
	capabilities = capabilities,
	settings = {
		tailwindCSS = {
			validate = true,
			lint = {
				cssConflict = "warning",
				invalidApply = "error",
				invalidScreen = "error",
				invalidVariant = "error",
				invalidConfigPath = "error",
				invalidTailwindDirective = "error",
				recommendedVariantOrder = "warning",
			},
			classAttributes = {
				"class",
				"className",
				"class:list",
				"classList",
				"ngClass",
			},
			includeLanguages = {
				eelixir = "html-eex",
				elixir = "phoenix-heex",
				eruby = "erb",
				heex = "phoenix-heex",
				htmlangular = "html",
				templ = "html",
			},
		},
	},
})

-- 3. Helper: find Tailwind project root
local function get_root(bufnr)
	local fname = vim.api.nvim_buf_get_name(bufnr)
	if fname == "" then
		return nil
	end

	local root_files = {
		"tailwind.config.js",
		"tailwind.config.cjs",
		"tailwind.config.mjs",
		"tailwind.config.ts",
		"postcss.config.js",
		"postcss.config.cjs",
		"postcss.config.mjs",
		"postcss.config.ts",
		".git", -- fallback (Tailwind v4)
	}

	local found = vim.fs.find(root_files, { path = fname, upward = true })
	return found and vim.fs.dirname(found[1]) or nil
end

-- 4. Start Tailwind LSP per buffer (restricted & deduped)
vim.api.nvim_create_autocmd("FileType", {
	pattern = {
		-- IMPORTANT: do NOT include javascript / typescript
		"html",
		"css",
		"scss",
		"javascriptreact",
		"typescriptreact",
		"vue",
		"svelte",
	},
	callback = function(args)
		-- Prevent duplicate clients
		for _, client in pairs(vim.lsp.get_clients({ bufnr = args.buf })) do
			if client.name == "tailwindcss" then
				return
			end
		end

		local root_dir = get_root(args.buf)
		if not root_dir then
			return
		end

		vim.lsp.start({
			name = "tailwindcss",
			bufnr = args.buf,
			root_dir = root_dir,
			workspace_folders = {
				{
					uri = vim.uri_from_fname(root_dir),
					name = "tailwindcss",
				},
			},
		})
	end,
})
